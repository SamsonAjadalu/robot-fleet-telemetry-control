# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=robot_fleet
DB_USER=robot_admin
DB_PASSWORD=local_testing_password

# Redis relay (shared by all API instances)
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_REQUIRED=false
REDIS_CHANNEL=robot-fleet:websocket

# Browser origins and API URLs
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
BACKEND_BASE_URL=ws://localhost:8000
